{
  "name": "@x-soft88/x-ui",
  "version": "0.1.0",
  "description": "A Vue 3 UI component library.",
  "type": "module",
  "files": [
    "dist",
    "src/remixicon.css"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/x-ui.js",
  "module": "./dist/x-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/x-ui.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./rich-text-editor": {
      "types": "./dist/rich-text-editor.d.ts",
      "import": "./dist/rich-text-editor.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./style.css": "./dist/style.css",
    "./remixicon.css": "./src/remixicon.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "story": "set VITE_CJS_IGNORE_WARNING=true&& histoire dev",
    "story:build": "set VITE_CJS_IGNORE_WARNING=true&& histoire build",
    "story:preview": "set VITE_CJS_IGNORE_WARNING=true&& histoire preview",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "api:naming:audit": "node scripts/audit-api-naming.mjs",
    "api:naming:audit:write": "node scripts/audit-api-naming.mjs --write",
    "api:naming:audit:check": "node scripts/audit-api-naming.mjs --check --max-legacy=0 --max-review=0",
    "build": "vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "prepublishOnly": "pnpm api:naming:audit:check && pnpm test && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "echarts": "^5.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "0.17.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "echarts": "^5.6.0",
    "histoire": "0.17.17",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "lowlight": "^3.3.0",
    "remixicon": "^4.9.1",
    "vue-grid-layout-v3": "^3.1.2",
    "xlsx": "^0.18.5"
  }
}
